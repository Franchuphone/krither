# Patterns without a leading "/" match at any depth, so these apply to every
# subproject folder (next-env/, hardhat-env/, and any added later).

# === Dependencies ===
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# === Environment / secrets (any folder, any variant) ===
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# === Node / build output ===
dist/
build/
out/
*.tsbuildinfo
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Next.js ===
.next/
next-env.d.ts
.vercel

# === Prisma ===
# Client rebuilt by postinstall / `pnpm db:generate`. Needs the ** prefix: a
# pattern holding a slash is anchored to this file's folder, not any depth.
**/src/generated/

# === Hardhat / Solidity ===
cache/
artifacts/
typechain/
typechain-types/
ignition/deployments/

# === Testing / analysis tooling ===
.nyc_output/
crytic-export/

# === Certificates ===
*.pem

# === Editor / OS ===
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
